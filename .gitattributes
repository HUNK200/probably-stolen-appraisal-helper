# 统一换行符，避免 Windows / Linux 混合协作产生噪音
* text=auto eol=lf

# 文档
*.md   text eol=lf
*.txt  text eol=lf

# 脚本
*.sh   text eol=lf
*.bat  text eol=crlf
*.cmd  text eol=crlf
*.ps1  text eol=crlf

# 二进制资源（不做换行转换，也不做 diff）
*.png   binary
*.jpg   binary
*.dds   binary
*.wav   binary
*.ogg   binary
*.dll   binary
*.pdb   binary
*.zip   binary
