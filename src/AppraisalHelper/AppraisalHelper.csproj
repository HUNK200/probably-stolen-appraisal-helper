<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>netstandard2.1</TargetFramework>
    <LangVersion>latest</LangVersion>
    <AssemblyName>AppraisalHelper</AssemblyName>
    <RootNamespace>ProbablyStolen.AppraisalHelper</RootNamespace>
    <!-- 编译警告按需收紧；先保持默认，避免一开始就被噪音淹没 -->
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
  </PropertyGroup>

  <!--
    引用游戏自带的程序集。
    Private=false 表示不把游戏 DLL 复制到输出目录——游戏运行时已经加载了它们，
    复制过去反而会让模组包变大，而且与框架同名的 DLL 会被拒绝加载。
  -->
  <ItemGroup>
    <Reference Include="Assembly-CSharp">
      <HintPath>$(ManagedDir)\Assembly-CSharp.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine">
      <HintPath>$(ManagedDir)\UnityEngine.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.CoreModule">
      <HintPath>$(ManagedDir)\UnityEngine.CoreModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

</Project>
